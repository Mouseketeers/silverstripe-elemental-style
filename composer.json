{
    "name": "jellygnite/silverstripe-elemental-style",
    "description": "Dynamic styling for elemental blocks.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/admin": "^3",
        "dnadesign/silverstripe-elemental": "^6",
        "jellygnite/silverstripe-sliderfield": "^6"
    },
    "autoload": {
        "psr-4": {
            "Jellygnite\\ElementalStyle\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ],
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
